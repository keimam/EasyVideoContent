; Bahasa Indonesia translation overlay for Inno Setup 6 (Stage 8C.2, D4)
; Used alongside compiler:Default.isl so all standard & custom dialogs localize cleanly.

[LangOptions]
LanguageName=Bahasa Indonesia
LanguageID=$0421
LanguageCodePage=1252

[Messages]
SetupWindowTitle=Pemasangan %1
UninstallAppTitle=Hapus Pemasangan %1
UninstallAppFullTitle=Hapus Pemasangan %1
ButtonNext=&Lanjut >
ButtonBack=< &Kembali
ButtonInstall=&Pasang
ButtonFinish=&Selesai
ButtonCancel=Batal
WelcomeLabel1=Selamat datang di Pemasang [name]
WelcomeLabel2=Program ini akan memasang [name/ver] ke komputer Anda.%n%nAnda disarankan menutup aplikasi lain yang berjalan sebelum melanjutkan.
WizardLicense=Perjanjian Lisensi
LicenseLabel=Harap baca informasi lisensi penting berikut sebelum melanjutkan.
LicenseLabel3=Harap baca Perjanjian Lisensi berikut. Anda harus menyetujui ketentuan ini sebelum melanjutkan pemasangan.
LicenseAccepted=Saya &menyetujui perjanjian tersebut
LicenseNotAccepted=Saya &tidak menyetujui perjanjian tersebut
WizardSelectDir=Pilih Lokasi Pemasangan
SelectDirDesc=Di mana [name] akan dipasang?
SelectDirLabel3=Pemasang akan memasang [name] ke folder berikut.
WizardSelectTasks=Pilih Tugas Tambahan
SelectTasksDesc=Tugas tambahan apa yang harus dijalankan?
WizardReady=Siap Memasang
ReadyLabel1=Pemasang sekarang siap memasang [name] ke komputer Anda.
WizardInstalling=Memasang
InstallingLabel=Harap tunggu sementara Pemasang memasang [name] ke komputer Anda.
FinishedHeadingLabel=Menyelesaikan Pemasang [name]
FinishedLabel=Pemasang telah selesai memasang [name] ke komputer Anda. Aplikasi dapat dijalankan melalui pintasan Start Menu atau Desktop.
RunEntryShellExec=Jalankan %1

[CustomMessages]
AdditionalIcons=Pintasan tambahan:
CreateDesktopIcon=Buat pintasan di &Desktop
LaunchProgram=Jalankan %1 sekarang
UninstallRemoveDataPrompt=Apakah Anda juga ingin menghapus folder data pengguna (%1)?%n%nFolder ini berisi config.toml, proyek video, preset kustom, cache, dan log.%nPilih "Tidak" (disarankan) untuk menyimpan proyek dan pengaturan Anda.
